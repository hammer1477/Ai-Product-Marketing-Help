NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# AI provider selection — "mock" works with no API keys.
# Recommended real setup: Gemini for text + vision (free at
# https://aistudio.google.com/apikey — image generation is NOT free on
# Gemini, so use "pollinations" for images, which needs no key at all.
AI_TEXT_PROVIDER=mock
AI_VISION_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
GEMINI_API_KEY=
# Optional: lifts Pollinations' free-tier limit of one image per ~45 s per IP
# (campaigns and photoshoots generate several at once). enter.pollinations.ai
POLLINATIONS_API_KEY=

# Shared secret protecting the internal job-worker and cron endpoints
CRON_SECRET=generate-a-random-value

# Stripe — credit pack purchases (/credits). Without STRIPE_SECRET_KEY the
# packs show but can't be bought. Webhook: point it at /api/stripe/webhook
# with events checkout.session.completed and
# checkout.session.async_payment_succeeded.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: public URL used for Stripe redirects (defaults to the request host)
NEXT_PUBLIC_SITE_URL=
